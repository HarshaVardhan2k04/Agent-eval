{
  "name": "agent-eval-backend",
  "version": "1.0.0",
  "description": "Agent Eval backend — Express + Sequelize (house style)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:make": "sequelize-cli migration:generate --name"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "cors": "^2.8.5",
    "diff": "^5.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "pg": "^8.16.0",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "sequelize-cli": "^6.6.2"
  }
}
